# Docker
PREFIX=tess

# Rails
SECRET_KEY_BASE=changeme

# Database (db is the docker container name)
DB_HOST=db
DB_PORT=5432
DB_NAME=tess
DB_USER=tess
DB_PASSWORD=password

# Seed Admin User
ADMIN_EMAIL=admin@localhost
ADMIN_USERNAME=admin_user
ADMIN_PASSWORD=changeme!

# SOLR (solr is the docker container name)
SOLR_URL=http://solr:8983/solr/tess

# REDIS (redis is the docker container name)
REDIS_URL=redis://redis:6379/1
REDIS_TEST_URL=redis://redis:6379/0

# EGI-TeSS-specific
TESS_BASE_HOST="registry.hopto.org"
TESS_BASE_URL="https://${TESS_BASE_HOST}"

# EGI LLM
EGI_LLM_SERVER_URL="https://llm.ai.egi.eu/v1/chat/completions"
EGI_LLM_API_KEY="change_me_llm"
# Available LLM models:
# glm
# qwen3.5
# qwen3.8-flash-next
# qwen3.8-27b
# gpt-oss-120b
# glm-5.2
# kimi-k3
# mistral-small-4:119b
EGI_LLM_MODEL="glm"
EGI_LLM_TIMEOUT="120"

# EGI auth
EGI_CLIENT_ID="change"
EGI_CLIENT_SECRET="change"
EGI_ISSUER="https://aai-demo.egi.eu/auth/realms/egi"
EGI_REDIRECT_URL="${TESS_BASE_URL}/users/auth/egi/callback"

# ==========================================
# TeSS Ingestor sources
# ==========================================
GITLAB_API_URL="https://code.europa.eu"
GITLAB_PROJECT_PATH="eurohpc-ju/evita"
GITLAB_API_BASE="https://code.europa.eu/api/v4"
GITLAB_PAGES_URL="https://introduction-to-cuda-a191ac.pages.code.europa.eu/"
HPC_PORTAL_BASE_URL="https://hpc-portal.eu"
HPC_PORTAL_MAX_PAGES="1500"
HPC_PORTAL_REQUEST_DELAY="0.3"

# FIXME: not used - maybe to remove
EGI_WEBSITE_URL="https://www.egi.eu"
