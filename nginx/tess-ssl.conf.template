upstream rails_app {
    server unix:/run/puma/puma.sock;
}

server {
    listen 443 ssl;
    server_name ${TESS_BASE_HOST};

    root /TeSS/public;

    location ^~ /system/ {
        expires max;
        add_header Cache-Control public;
        try_files $uri =404;
    }

    ssl_certificate /etc/letsencrypt/live/${TESS_BASE_HOST}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${TESS_BASE_HOST}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;

    access_log /var/log/nginx/tess_access.log;
    error_log /var/log/nginx/tess_error.log notice;

    location / {
        proxy_pass http://rails_app;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Ssl on;
        proxy_set_header X-Forwarded-Host $http_host;
        proxy_set_header X-Forwarded-Port $server_port;

        proxy_connect_timeout 10s;
        proxy_send_timeout 300s;
        proxy_read_timeout 300s;
    }
}