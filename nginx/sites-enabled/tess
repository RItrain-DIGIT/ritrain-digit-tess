server {

    listen 443 ssl;
    server_name registry.hopto.org;

    # Set root to the main public folder
    root /TeSS/public;

    # Uploaded files (volume `uploads` mounted read-only) served directly by nginx
    location ^~ /system/ {
        root /TeSS/public;
        expires max;
        add_header Cache-Control public;
        try_files $uri =404;
    }

    ssl_certificate 	/etc/letsencrypt/live/registry.hopto.org/fullchain.pem; # managed by Certbot
    ssl_certificate_key /etc/letsencrypt/live/registry.hopto.org/privkey.pem; # managed by Certbot
    include 		/etc/letsencrypt/options-ssl-nginx.conf; # managed by Certbot
    ssl_dhparam 	/etc/letsencrypt/ssl-dhparams.pem; # managed by Certbot

    # --- LOG FILES ---
    access_log /var/log/nginx/tess_access.log;
    error_log  /var/log/nginx/tess_error.log notice; # Options: debug, info, notice, warn, error, crit, alert, emerg
    # -----------------

    location / {
        # Name of docker container where the Rails app exists
        proxy_pass  http://app:3000;
    
    	proxy_set_header Host $host;
	    proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;

        # Tells Rails the browser is connected over HTTPS
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Ssl on; # Optional
        proxy_set_header X-Forwarded-Host $http_host;
        proxy_set_header X-Forwarded-Port $server_port;
    }
}

