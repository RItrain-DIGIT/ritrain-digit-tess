<div id="egi-chat-widget" class="egi-chat-container">
  <button id="egi-chat-toggle" class="egi-chat-btn">
    💬 Ask EGI AI
  </button>

  <div id="egi-chat-window" class="egi-chat-window hidden">
    <div class="egi-chat-header">
      <span>EGI Assistant</span>
      <button id="egi-chat-close">&times;</button>
    </div>

    <div id="egi-chat-messages" class="egi-chat-body">
      <div class="chat-msg assistant">
        Hello! How can I assist you today?
      </div>
    </div>

    <div class="egi-chat-footer">
      <input
        type="text"
        id="egi-chat-input"
        placeholder="Type a question..."
      />
      <button id="egi-chat-send">Send</button>
    </div>
  </div>
</div>
