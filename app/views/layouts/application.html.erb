<!DOCTYPE html>
<html lang="en">

<%= render 'layouts/head' %>

<body class="<%= 'sticky-navbar-enabled' if TeSS::Config.feature['sticky_navbar'] %> <%= 'header-notice-present' if TeSS::Config.header_notice&.strip.present? %>">
<%= render partial: 'layouts/header' %>

<div id="main-container" class="<%= @container_class || 'container-fluid' %>">
  <%= render 'common/breadcrumbs' if @breadcrumbs %>

  <%# Main content of every page -%>
  <%= yield %>
</div>

<%# Other layout content above %>

<%# EGI LLM Chat Widget %>
<div id="egi-chat-widget" class="egi-chat-container">
  <button id="egi-chat-toggle" class="egi-chat-btn">
    💬 Ask EGI AI
  </button>

  <div id="egi-chat-window" class="egi-chat-window hidden">
    <div class="egi-chat-header">
      <span>EGI Assistant</span>
      <button id="egi-chat-close">&times;</button>
    </div>
    <div id="egi-chat-messages" class="egi-chat-body">
      <div class="chat-msg assistant">Hello! How can I assist you today?</div>
    </div>
    <div class="egi-chat-footer">
      <input type="text" id="egi-chat-input" placeholder="Type a question..." />
      <button id="egi-chat-send">Send</button>
    </div>
  </div>
</div>

<%= render partial: 'layouts/footer' %>

</body>
</html>
