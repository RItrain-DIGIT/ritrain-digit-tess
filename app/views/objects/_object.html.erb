<%# app/views/objects/_object.html.erb %>
<%# Local variable 'object' is automatically passed when using render @objects %>

<% cache object do %>
  <div id="<%= dom_id(object) %>" class="object-card border rounded p-4 mb-3 shadow-sm">
    <div class="d-flex justify-content-between align-items-center mb-2">
      <h3 class="h5 mb-0 font-weight-bold">
        <%= link_to object.name, object, class: "text-decoration-none" %>
      </h3>
      <span class="badge badge-secondary text-muted small">
        <%= object.created_at.strftime("%b %d, %Y") %>
      </span>
    </div>

    <% if object.respond_to?(:description) && object.description.present? %>
      <p class="text-body mb-3">
        <%= truncate(object.description, length: 120) %>
      </p>
    <% end %>

    <div class="object-actions d-flex gap-2">
      <%= link_to "View", object, class: "btn btn-sm btn-outline-primary" %>
      <%= link_to "Edit", edit_object_path(object), class: "btn btn-sm btn-outline-secondary" %>
      <%= button_to "Delete", object, 
                    method: :delete, 
                    data: { confirm: "Are you sure?" }, 
                    class: "btn btn-sm btn-outline-danger" %>
    </div>
  </div>
<% end %>
